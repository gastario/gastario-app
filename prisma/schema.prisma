generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  OFFICE
  KITCHEN
  DRIVER
  VIEWER
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum PlanCode {
  STARTER
  PROFESSIONAL
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum FeatureCode {
  DASHBOARD
  ORDERS
  CUSTOMERS
  PRODUCTS
  QUOTES
  PRODUCTION
  PACKING_LISTS
  DELIVERY_NOTES
  DELIVERIES
  INCOMING_ORDERS
  PDF_EXTRACTION
  EMAIL_AUTOMATION
  PURCHASING
  INVENTORY
  SUPPLIERS
  RECIPES
  REPORTS
  MULTI_USER
  DRIVER_VIEW
  PRODUCT_MAPPING
  INTEGRATIONS
}

enum OrderSource {
  DIRECT
  EMAIL
  HEYCATER
  EGORA
  WEBSITE
  LEXWARE
  OTHER
}

enum OrderStatus {
  AUTO_CREATED
  REVIEW_NEEDED
  INCOMPLETE
  POSSIBLE_DUPLICATE
  CONFIRMED
  IN_PRODUCTION
  PACKING_OPEN
  DELIVERED
  CANCELLED
  REJECTED
}

enum QuoteStatus {
  DRAFT
  SENT
  WAITING
  CONFIRMED
  REJECTED
  EXPIRED
}

enum IncomingEmailStatus {
  RECEIVED
  PDF_FOUND
  EXTRACTED
  ORDER_CREATED
  REVIEW_NEEDED
  FAILED
  DUPLICATE
  IGNORED
}

enum ExtractionConfidence {
  HIGH
  MEDIUM
  LOW
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  passwordHash   String?
  sessionVersion Int          @default(0)
  platformRole   PlatformRole @default(USER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenants             TenantUser[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Tenant {
  id                    String      @id @default(cuid())
  name                  String
  slug                  String      @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  invoiceClosingTextEn  String?
  invoiceClosingTextDe  String?
  invoicePaymentTermsEn String?
  invoicePaymentTermsDe String?
  invoiceBankName       String?
  invoiceBic            String?
  invoiceIban           String?
  invoicePhone          String?
  invoiceEmail          String?
  invoiceVatId          String?
  invoiceTaxNumber      String?
  invoiceSellerAddress  String?
  invoiceSellerName     String?
  invoices              Invoice[]
  foodLabels            FoodLabel[]

  planCode           PlanCode           @default(STARTER)
  subscriptionStatus SubscriptionStatus @default(TRIAL)

  maxBrands        Int @default(1)
  maxEmailAccounts Int @default(1)
  maxUsers         Int @default(1)

  trialEndsAt DateTime?
  lockedAt    DateTime?
  lockReason  String?

  users                        TenantUser[]
  brands                       Brand[]
  emailAccounts                EmailAccount[]
  enabledFeatures              TenantFeature[]
  customers                    Customer[]
  products                     Product[]
  quotes                       Quote[]
  orders                       Order[]
  deliveryNotes                DeliveryNote[]
  incomingEmails               IncomingEmail[]
  deliveryTours                DeliveryTour[]
  deliveryStops                DeliveryStop[]
  productMappings              ProductMapping[]
  recipeItems                  ProductRecipeItem[]
  suppliers                    Supplier[]
  inventoryItems               InventoryItem[]
  supplierConnections          SupplierConnection[]
  supplierCatalogItems         SupplierCatalogItem[]
  supplierPriceSnapshots       SupplierPriceSnapshot[]
  supplierSyncRuns             SupplierSyncRun[]
  productSupplierMatches       ProductSupplierMatch[]
  procurementIngredients       ProcurementIngredient[]
  procurementIngredientMatches ProcurementIngredientMatch[]
  procurementOrderDrafts       ProcurementOrderDraft[]
  procurementOrderDraftItems   ProcurementOrderDraftItem[]
  accountingConnections        AccountingConnection[]
  procurementOrderEmailLogs    ProcurementOrderEmailLog[]
}

model TenantUser {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model TenantFeature {
  id        String      @id @default(cuid())
  tenantId  String
  feature   FeatureCode
  enabled   Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature])
  @@index([tenantId])
}

model Brand {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String?
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailAccounts EmailAccount[]
  orders        Order[]

  @@index([tenantId])
}

model EmailAccount {
  id       String  @id @default(cuid())
  tenantId String
  brandId  String?
  email    String
  label    String?
  active   Boolean @default(true)

  provider String?
  mode     String  @default("FORWARDING")
  notes    String?

  imapHost              String?
  imapPort              Int?
  imapSecure            Boolean   @default(true)
  imapUsername          String?
  imapPasswordEncrypted String?
  imapLastCheckedAt     DateTime?
  imapLastUid           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand  Brand? @relation(fields: [brandId], references: [id])

  rules          EmailRule[]
  incomingEmails IncomingEmail[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([brandId])
}

model EmailRule {
  id              String      @id @default(cuid())
  tenantId        String
  emailAccountId  String
  name            String
  source          OrderSource
  subjectContains String?
  senderContains  String?
  autoCreateOrder Boolean     @default(true)
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([emailAccountId])
}

model Customer {
  /**
   * gastario-customer-master-data-20260716
   * Zentrale Kundenstammdaten für Aufträge,
   * Lieferungen und Rechnungen.
   */
  id       String @id @default(cuid())
  tenantId String

  customerNumber String
  customerType   CustomerType @default(BUSINESS)
  name           String
  contactName    String?
  email          String?
  invoiceEmail   String?
  phone          String?

  address     String?
  street      String?
  houseNumber String?
  postalCode  String?
  city        String?
  country     String  @default("DE")

  differentDeliveryAddress Boolean @default(false)
  deliveryStreet           String?
  deliveryHouseNumber      String?
  deliveryPostalCode       String?
  deliveryCity             String?
  deliveryCountry          String?

  vatId           String?
  costCenter      String?
  paymentTermDays Int             @default(14)
  invoiceLanguage InvoiceLanguage @default(DE)
  notes           String?
  active          Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]
  quotes Quote[]

  @@unique([tenantId, customerNumber])
  @@index([tenantId])
  @@index([tenantId, active])
  @@index([name])
}

enum ProductProcurementType {
  RECIPE
  READY_MADE
  BAKE_OFF
  THAW
  REHEAT
  EXTERNAL
}

enum ProductOperationalArea {
  REVIEW
  KITCHEN
  PACKING
  LOGISTICS
  NON_OPERATIONAL
}

model Product {
  id         String  @id @default(cuid())
  tenantId   String
  name       String
  category   String?
  unit       String  @default("Portion")
  priceCents Int     @default(0)
  taxRate    Int     @default(7)
  active     Boolean @default(true)

  operationalArea ProductOperationalArea @default(REVIEW)

  procurementType         ProductProcurementType @default(RECIPE)
  supplierName            String?
  supplierArticleName     String?
  supplierArticleNumber   String?
  purchaseUnit            String?
  purchaseQuantityPerUnit Float?
  packageUnit             String?
  packageQuantity         Float?
  purchasePriceCents      Int?
  preparationNotes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  quoteItems      QuoteItem[]
  productMappings ProductMapping[]
  recipeItems     ProductRecipeItem[]
  suppliers       Supplier[]
  inventoryItems  InventoryItem[]
  supplierMatches ProductSupplierMatch[]

  @@index([tenantId])
  @@index([name])
  @@index([tenantId, operationalArea])
}

model ProductMapping {
  id           String      @id @default(cuid())
  tenantId     String
  externalName String
  source       OrderSource
  productId    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([externalName])
}

model IncomingEmail {
  id             String              @id @default(cuid())
  tenantId       String
  emailAccountId String?
  brandId        String?
  mailbox        String
  sender         String?
  subject        String
  bodyText       String?
  source         OrderSource         @default(EMAIL)
  status         IncomingEmailStatus @default(RECEIVED)

  messageId   String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  extractedJson Json?
  errorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailAccount EmailAccount?     @relation(fields: [emailAccountId], references: [id])
  attachments  EmailAttachment[]
  orders       Order[]

  @@index([tenantId])
  @@index([emailAccountId])
  @@index([mailbox])
  @@index([status])
  @@index([receivedAt])
}

model EmailAttachment {
  id              String   @id @default(cuid())
  incomingEmailId String
  filename        String
  mimeType        String?
  fileUrl         String?
  textContent     String?
  extractedJson   Json?
  createdAt       DateTime @default(now())

  incomingEmail IncomingEmail @relation(fields: [incomingEmailId], references: [id], onDelete: Cascade)

  @@index([incomingEmailId])
}

/**
 * gastario-live-quotes-20260716
 * Echte, mandantenfähige Angebote mit Kunden,
 * Positionen und späterer Auftragsübernahme.
 */
model Quote {
  id         String  @id @default(cuid())
  tenantId   String
  customerId String?

  quoteNumber String
  status      QuoteStatus @default(DRAFT)

  customerName String
  eventName    String?

  eventDate        DateTime?
  deliveryTimeText String?
  deliveryAddress  String?

  contactName  String?
  contactEmail String?
  contactPhone String?

  validUntil DateTime?
  notes      String?

  subtotalCents Int @default(0)
  discountCents Int @default(0)
  totalCents    Int @default(0)

  convertedOrderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    QuoteItem[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([eventDate])
  @@index([createdAt])
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String

  productId String?
  name      String

  quantity   Int    @default(1)
  unit       String @default("Portion")
  unitCents  Int    @default(0)
  totalCents Int    @default(0)

  taxRate Int     @default(7)
  notes   String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@index([productId])
}

model Order {
  id              String  @id @default(cuid())
  tenantId        String
  brandId         String?
  customerId      String?
  incomingEmailId String?

  orderNumber         String
  externalOrderNumber String?
  source              OrderSource
  status              OrderStatus @default(AUTO_CREATED)

  customerName     String
  eventName        String?
  deliveryDate     DateTime?
  deliveryTimeText String?
  deliveryAddress  String?
  contactName      String?
  contactPhone     String?
  notes            String?

  productionStartedAt   DateTime?
  productionCompletedAt DateTime?
  packingStartedAt      DateTime?
  packingCompletedAt    DateTime?
  packingChecklist      Json?

  billingMode           BillingMode     @default(UNDECIDED)
  billingStatus         BillingStatus   @default(NOT_BILLED)
  invoiceLanguage       InvoiceLanguage @default(DE)
  platformName          String?
  platformReference     String?
  externalInvoiceNumber String?
  allergens             String?

  totalCents      Int                  @default(0)
  confidenceScore Int                  @default(0)
  confidenceLabel ExtractionConfidence @default(LOW)
  reviewReason    String?

  originalPdfName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand           Brand?         @relation(fields: [brandId], references: [id])
  customer        Customer?      @relation(fields: [customerId], references: [id])
  incomingEmail   IncomingEmail? @relation(fields: [incomingEmailId], references: [id])
  items           OrderItem[]
  invoices        Invoice[]
  deliveryNote    DeliveryNote?
  customerCountry String         @default("DE")
  customerVatId   String?

  customerType CustomerType @default(BUSINESS)
  taxTreatment TaxTreatment @default(DOMESTIC_19)

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([source])
  @@index([status])
  @@index([deliveryDate])
}

model DeliveryNote {
  id       String @id @default(cuid())
  tenantId String
  orderId  String @unique

  number   String
  filename String
  mimeType String @default("application/pdf")
  pdfData  Bytes

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([generatedAt])
}

model OrderItem {
  id                  String                  @id @default(cuid())
  orderId             String
  name                String
  quantity            Int                     @default(1)
  unit                String                  @default("Stueck")
  unitCents           Int                     @default(0)
  totalCents          Int                     @default(0)
  notes               String?
  operationalQuantity Float?
  operationalUnit     String?
  operationalArea     ProductOperationalArea?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
  productId String?

  @@index([orderId])
}

model FoodLabel {
  id       String @id @default(cuid())
  tenantId String

  productName    String
  customerName   String?
  productionDate DateTime
  bestBeforeDate DateTime
  batchNumber    String?
  storageNote    String?
  allergens      String?
  ingredients    String?
  quantityText   String?

  labelCount  Int     @default(1)
  labelSize   String  @default("76x51")
  publicToken String? @unique
  status      String  @default("CREATED")

  printedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productionDate])
  @@index([bestBeforeDate])
  @@index([createdAt])
}

model RegistrationInvite {
  id        String    @id @default(cuid())
  code      String    @unique
  note      String?
  email     String?
  usedAt    DateTime?
  usedBy    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  category     String?
  unit         String   @default("Stueck")
  currentStock Float    @default(0)
  minStock     Float    @default(0)
  supplierName String?
  location     String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
  productId String?

  @@index([tenantId])
  @@index([active])
}

model Supplier {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  category    String?
  contactName String?
  email       String?
  phone       String?
  items       String?
  orderDays   String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product              Product?              @relation(fields: [productId], references: [id])
  productId            String?
  supplierConnections  SupplierConnection[]
  supplierCatalogItems SupplierCatalogItem[]

  @@index([tenantId])
  @@index([active])
}

model ProductRecipeItem {
  id              String   @id @default(cuid())
  tenantId        String
  productId       String
  ingredientName  String
  quantityPerUnit Float
  unit            String   @default("g")
  supplierName    String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model DeliveryTour {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  driverName   String?
  driverEmail  String?
  driverPhone  String?
  deliveryDate DateTime?
  status       String    @default("OPEN")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stops  DeliveryStop[]

  @@index([tenantId])
  @@index([deliveryDate])
  @@index([status])
}

model DeliveryStop {
  id          String   @id @default(cuid())
  tenantId    String
  tourId      String
  orderId     String
  sortOrder   Int      @default(0)
  plannedTime String?
  status      String   @default("OPEN")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tour   DeliveryTour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, orderId])
  @@index([tenantId])
  @@index([tourId])
  @@index([orderId])
}

enum BillingMode {
  UNDECIDED
  DIRECT_INVOICE
  EXTERNAL_INVOICE
  PLATFORM_CREDIT
  NO_INVOICE
}

enum BillingStatus {
  NOT_BILLED
  READY_TO_INVOICE
  INVOICED
  INVOICED_EXTERNALLY
  WAITING_FOR_CREDIT
  CREDIT_RECEIVED
  NOT_RELEVANT
}

enum InvoiceType {
  DIRECT
  EXTERNAL
  PLATFORM_CREDIT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  CORRECTED
}

enum InvoiceNumberSource {
  GASTARIO
  CASH_REGISTER
  LEXWARE
  PLATFORM
  MANUAL
}

model Invoice {
  id       String  @id @default(cuid())
  tenantId String
  orderId  String?

  type         InvoiceType         @default(DIRECT)
  status       InvoiceStatus       @default(DRAFT)
  numberSource InvoiceNumberSource @default(MANUAL)

  language              InvoiceLanguage @default(DE)
  internalNumber        String?
  externalInvoiceNumber String?
  sourceSystem          String?

  invoiceDate DateTime?
  serviceDate DateTime?
  dueDate     DateTime?

  customerName    String
  customerEmail   String?
  customerAddress String?

  customerCountry String  @default("DE")
  sellerName      String?
  sellerAddress   String?
  sellerTaxNumber String?
  sellerVatId     String?

  currency        String @default("EUR")
  netTotalCents   Int    @default(0)
  taxTotalCents   Int    @default(0)
  grossTotalCents Int    @default(0)

  reverseChargeNoteDe String?
  notes               String?
  issuedAt            DateTime?
  paidAt              DateTime?
  cancelledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id])

  items        InvoiceItem[]
  customerType CustomerType  @default(BUSINESS)
  taxTreatment TaxTreatment  @default(DOMESTIC_19)

  customerVatId       String?
  reverseChargeNoteEn String?
  paymentTermsDe      String?
  paymentTermsEn      String?

  @@unique([tenantId, externalInvoiceNumber])
  @@index([tenantId])
  @@index([orderId])
  @@index([status])
  @@index([invoiceDate])
}

model InvoiceItem {
  id        String @id @default(cuid())
  invoiceId String

  position Int    @default(1)
  type     String @default("ITEM")

  name        String
  description String?

  quantity Float  @default(1)
  unit     String @default("Stueck")

  unitCents       Int @default(0)
  discountPercent Int @default(0)
  discountCents   Int @default(0)
  netTotalCents   Int @default(0)
  taxRate         Int @default(19)
  taxTotalCents   Int @default(0)
  grossTotalCents Int @default(0)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([position])
}

enum InvoiceLanguage {
  DE
  EN
}

enum CustomerType {
  PRIVATE
  BUSINESS
}

enum TaxTreatment {
  DOMESTIC_19
  DOMESTIC_7
  TAX_FREE
  REVERSE_CHARGE
  EXPORT
  OTHER
}

model ImportIgnoreRule {
  id       String @id @default(cuid())
  tenantId String

  isActive Boolean @default(true)

  source          String?
  senderContains  String?
  subjectContains String?
  textContains    String?

  createdFromOrderId String?
  createdFromEmailId String?

  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
}

/**
 * gastario-accounting-read-connection-20260729
 * Mandantenfähige, rein lesende Anbindung externer Buchhaltungssysteme.
 */

enum AccountingProvider {
  LEXWARE
}

enum AccountingConnectionStatus {
  DISCONNECTED
  CONFIGURED
  ACTIVE
  ERROR
  PAUSED
}

model AccountingConnection {
  id       String @id @default(cuid())
  tenantId String

  provider AccountingProvider
  status   AccountingConnectionStatus @default(DISCONNECTED)

  label                String?
  credentialsEncrypted String
  organizationId       String?
  companyName          String?
  settingsJson         Json?

  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  nextSyncAt           DateTime?
  lastError            String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([status])
  @@index([nextSyncAt])
}

/**
 * gastario-supplier-daily-prices-20260726
 * Mandantenfähige Lieferantenkataloge, Tagespreise und Synchronisierungen.
 */

enum SupplierConnectionType {
  API
  PUNCHOUT
  BMECAT
  CXML
  EDI
  CSV
  EXCEL
  EMAIL
  MANUAL
}

enum SupplierConnectionStatus {
  DISCONNECTED
  CONFIGURED
  ACTIVE
  ERROR
  PAUSED
}

enum SupplierSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum SupplierPriceSource {
  API
  PUNCHOUT
  CATALOG
  CSV
  EXCEL
  EMAIL
  INVOICE
  MANUAL
}

enum SupplierMatchMethod {
  ARTICLE_NUMBER
  EAN
  GTIN
  MANUAL
  AI_SUGGESTION
}

model SupplierConnection {
  id         String @id @default(cuid())
  tenantId   String
  supplierId String

  type   SupplierConnectionType
  status SupplierConnectionStatus @default(DISCONNECTED)

  label          String?
  customerNumber String?
  endpointUrl    String?

  credentialsEncrypted String?
  settingsJson         Json?

  syncIntervalMinutes  Int       @default(1440)
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  nextSyncAt           DateTime?
  lastError            String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  catalogItems SupplierCatalogItem[]
  syncRuns     SupplierSyncRun[]

  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
  @@index([nextSyncAt])
}

model SupplierCatalogItem {
  id           String  @id @default(cuid())
  tenantId     String
  supplierId   String
  connectionId String?

  externalId    String?
  articleNumber String?
  ean           String?
  gtin          String?

  name         String
  brand        String?
  description  String?
  searchTokens String[] @default([])

  orderUnit            String?
  baseUnit             String?
  contentQuantity      Float?
  packageQuantity      Float?
  minimumOrderQuantity Float   @default(1)

  availabilityStatus String?
  active             Boolean   @default(true)
  lastSeenAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  connection SupplierConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  prices            SupplierPriceSnapshot[]
  matches           ProductSupplierMatch[]
  ingredientMatches ProcurementIngredientMatch[]

  procurementDraftItems ProcurementOrderDraftItem[]

  @@unique([supplierId, articleNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([connectionId])
  @@index([ean])
  @@index([gtin])
  @@index([name])
  @@index([searchTokens], type: Gin)
}

model SupplierPriceSnapshot {
  id            String @id @default(cuid())
  tenantId      String
  catalogItemId String

  netPriceCents   Int
  grossPriceCents Int?
  currency        String @default("EUR")

  priceUnitQuantity Float   @default(1)
  priceUnit         String?

  minimumQuantity Float?
  available       Boolean?
  stockText       String?

  promotional Boolean @default(false)

  qualityStatus       String    @default("UNCHECKED")
  qualityReason       String?
  referencePriceCents Int?
  priceRatio          Float?
  qualityCheckedAt    DateTime?

  source     SupplierPriceSource
  validFrom  DateTime?
  validUntil DateTime?
  fetchedAt  DateTime            @default(now())
  createdAt  DateTime            @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogItem SupplierCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([catalogItemId])
  @@index([fetchedAt])
  @@index([validUntil])
  @@index([netPriceCents])
  @@index([qualityStatus])
}

model SupplierSyncRun {
  id           String @id @default(cuid())
  tenantId     String
  connectionId String

  status SupplierSyncStatus @default(RUNNING)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  itemsSeen     Int @default(0)
  itemsCreated  Int @default(0)
  itemsUpdated  Int @default(0)
  pricesCreated Int @default(0)
  errorsCount   Int @default(0)

  errorMessage String?
  detailsJson  Json?

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection SupplierConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([connectionId])
  @@index([status])
  @@index([startedAt])
}

model ProductSupplierMatch {
  id            String @id @default(cuid())
  tenantId      String
  productId     String
  catalogItemId String

  method     SupplierMatchMethod @default(MANUAL)
  confidence Int                 @default(100)

  preferred Boolean @default(false)
  active    Boolean @default(true)

  conversionFactor Float   @default(1)
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  catalogItem SupplierCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([productId, catalogItemId])
  @@index([tenantId])
  @@index([productId])
  @@index([catalogItemId])
  @@index([preferred])
}

model ProcurementIngredient {
  id             String   @id @default(cuid())
  tenantId       String
  normalizedName String
  displayName    String
  baseUnit       String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matches ProcurementIngredientMatch[]

  @@unique([tenantId, normalizedName, baseUnit])
  @@index([tenantId])
  @@index([normalizedName])
  @@index([active])
}

enum ProcurementOrderDraftStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ProcurementPlanType {
  CHEAPEST
  PRACTICAL
}

model ProcurementOrderDraft {
  id             String                      @id @default(cuid())
  tenantId       String
  supplierId     String?
  supplierName   String
  planningDate   DateTime
  planType       ProcurementPlanType
  status         ProcurementOrderDraftStatus @default(DRAFT)
  currency       String                      @default("EUR")
  netTotalCents  Int                         @default(0)
  notes          String?
  orderedAt      DateTime?
  receivedAt     DateTime?
  emailedAt      DateTime?
  emailedTo      String?
  emailSubject   String?
  emailMessageId String?
  emailError     String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  tenant Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  ProcurementOrderDraftItem[]

  emailLogs ProcurementOrderEmailLog[]

  @@index([tenantId])
  @@index([supplierId])
  @@index([planningDate])
  @@index([status])
  @@index([planType])
  @@index([createdAt])
}

model ProcurementOrderDraftItem {
  id                   String   @id @default(cuid())
  tenantId             String
  draftId              String
  catalogItemId        String?
  ingredientName       String
  catalogItemName      String
  articleNumber        String?
  packageCount         Float
  packContent          Float?
  baseUnit             String?
  netUnitPriceCents    Int
  netTotalCents        Int
  receivedPackageCount Float    @default(0)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  draft       ProcurementOrderDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  catalogItem SupplierCatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([draftId])
  @@index([catalogItemId])
  @@index([ingredientName])
}

model ProcurementOrderEmailLog {
  id        String   @id @default(cuid())
  tenantId  String
  draftId   String
  recipient String
  subject   String
  message   String?
  status    String
  messageId String?
  error     String?
  createdAt DateTime @default(now())

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  draft  ProcurementOrderDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([draftId])
  @@index([status])
  @@index([createdAt])
}

model ProcurementIngredientMatch {
  id            String @id @default(cuid())
  tenantId      String
  ingredientId  String
  catalogItemId String

  method           SupplierMatchMethod @default(MANUAL)
  confidence       Int                 @default(100)
  preferred        Boolean             @default(false)
  active           Boolean             @default(true)
  conversionFactor Float               @default(1)
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredient  ProcurementIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  catalogItem SupplierCatalogItem   @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, catalogItemId])
  @@index([tenantId])
  @@index([ingredientId])
  @@index([catalogItemId])
  @@index([preferred])
  @@index([active])
}

model SupplierSearchAlias {
  id String @id @default(cuid())

  tenantId String

  canonicalTerm       String
  aliasTerm           String
  canonicalNormalized String
  aliasNormalized     String

  active   Boolean @default(true)
  source   String  @default("MANUAL")
  useCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, aliasNormalized])
  @@index([tenantId])
  @@index([tenantId, canonicalNormalized])
  @@index([tenantId, active])
}

model SupplierSearchLearningSuggestion {
  id String @id @default(cuid())

  tenantId String

  queryTerm           String
  queryNormalized     String
  candidateTerm       String
  candidateNormalized String

  evidenceCount Int    @default(1)
  status        String @default("PENDING")

  lastCatalogItemName String?
  lastSupplierName    String?
  firstSeenAt         DateTime @default(now())
  lastSeenAt          DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, queryNormalized, candidateNormalized])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, evidenceCount])
}

model SupplierSearchDiscovery {
  id String @id @default(cuid())

  tenantId String

  query           String
  queryNormalized String

  priority    Int @default(10)
  searchCount Int @default(1)

  status String @default("PENDING")

  lastRequestedAt DateTime  @default(now())
  lastProcessedAt DateTime?
  lastResultCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, queryNormalized])
  @@index([tenantId, status, priority])
  @@index([tenantId, lastRequestedAt])
}
