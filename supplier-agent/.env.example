# Optional: eigenes Chrome/Chromium Binary.
SUPPLIER_AGENT_CHROME_EXECUTABLE=

# Optional: statt eigenem Persistent Browser mit bestehendem CDP-Browser verbinden.
SUPPLIER_AGENT_CDP_URL=

# Separates Browserprofil. Keine normalen Chrome-Profile verwenden.
SUPPLIER_AGENT_PROFILE_DIR=

# false = sichtbarer Browser für Login/Debug.
SUPPLIER_AGENT_HEADLESS=false

# Log-Level: debug | info | warn | error
SUPPLIER_AGENT_LOG_LEVEL=info
